generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ Enums ============

enum Role {
  ADMIN
  PENGURUS
  ANGGOTA
}

enum Gender {
  LAKI_LAKI
  PEREMPUAN
}

enum MembershipStatus {
  AKTIF
  TIDAK_AKTIF
  PINDAH
  MENGUNDURKAN_DIRI
}

/// Izin granular yang bisa diberikan ke user PENGURUS tertentu.
/// ADMIN otomatis memiliki semua izin tanpa perlu baris UserPermission.
enum Permission {
  MANAGE_MEMBERS
  MANAGE_ACTIVITIES
  MANAGE_ATTENDANCE
  MANAGE_CASH_PAYMENT
  VIEW_CASH_REPORT
  MANAGE_POSITIONS
  MANAGE_PERIODS
  MANAGE_USERS
  VIEW_AUDIT_LOG
  MANAGE_CHOIR
}

enum ActivityType {
  IBADAH
  KEBAKTIAN
  PERSEKUTUAN
  RAPAT
  OLAHRAGA
  BAKTI_SOSIAL
  ACARA_GEREJA
  RETREAT
  PELAYANAN
  KEGIATAN_SOSIAL
  LAINNYA
}

enum ActivityStatus {
  DIRENCANAKAN
  BERLANGSUNG
  SELESAI
  DIBATALKAN
}

enum AttendanceStatus {
  HADIR
  TIDAK_HADIR
  IZIN
  SAKIT
}

enum CashPaymentStatus {
  BELUM_BAYAR
  LUNAS
  PENDING
  DIBATALKAN
}

enum PaymentMethod {
  CASH
  TRANSFER
  LAINNYA
}

enum PositionStatus {
  AKTIF
  NONAKTIF
}

enum TransactionType {
  MASUK
  KELUAR
}

enum PostType {
  PENGUMUMAN
  FORUM
}

enum PasswordResetStatus {
  PENDING
  DONE
}

// ============ Core: User (akun + profil anggota) ============

model User {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  phone        String
  passwordHash String

  role     Role    @default(ANGGOTA)
  isActive Boolean @default(true)

  memberNumber      String?          @unique
  nickname          String?
  gender            Gender?
  birthPlace        String?
  birthDate         DateTime?
  /// Tubu/boru ni mama -- marga (klan) pihak ibu, sesuai adat Batak.
  /// Diisi Admin/Pengurus, sama seperti data biodata lainnya.
  motherClan        String?
  address           String?
  membershipStatus  MembershipStatus @default(AKTIF)
  notes             String?
  photoUrl          String?
  joinedAt          DateTime         @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions       UserPermission[]
  positions         Position[]
  attendances       Attendance[]        @relation("AttendanceMember")
  recordedAttendance Attendance[]       @relation("AttendanceRecorder")
  cashPayments      CashPayment[]       @relation("CashPaymentMember")
  recordedPayments  CashPayment[]       @relation("CashPaymentRecorder")
  transactions      Transaction[]
  createdActivities Activity[]          @relation("ActivityCreator")
  picActivities     Activity[]          @relation("ActivityPIC")
  posts             Post[]
  comments          Comment[]
  auditLogs         AuditLog[]
  choirSongs        ChoirSong[]
  resolvedPasswordResets PasswordResetRequest[]
  profileEditRequests         ProfileEditRequest[] @relation("ProfileEditRequester")
  resolvedProfileEditRequests ProfileEditRequest[] @relation("ProfileEditResolver")

  @@index([membershipStatus])
  @@index([role])
}

model UserPermission {
  id         String     @id @default(cuid())
  userId     String
  permission Permission
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
}

// ============ Kepengurusan & Periode ============

model ManagementPeriod {
  id        String   @id @default(cuid())
  name      String
  startYear Int
  endYear   Int
  isActive  Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  positions Position[]
}

/// Jabatan dalam kepengurusan. TIDAK wajib terhubung ke akun anggota
/// terdaftar — banyak nama di SK kepengurusan resmi belum tentu sudah
/// mendaftar akun. Kalau `userId` kosong, `memberName` dipakai sebagai
/// nama tampilan (diisi dari SK). Begitu orangnya mendaftar akun, admin
/// bisa menghubungkan jabatannya ke akun tsb lewat `userId`.
model Position {
  id         String         @id @default(cuid())
  title      String
  memberName String?
  userId     String?
  periodId   String
  startDate  DateTime?
  endDate    DateTime?
  status     PositionStatus @default(AKTIF)
  order      Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user   User?            @relation(fields: [userId], references: [id])
  period ManagementPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId])
}

// ============ Kegiatan & Kehadiran ============

model Activity {
  id               String         @id @default(cuid())
  name             String
  type             ActivityType
  description      String
  date             DateTime
  location         String
  personInChargeId String?
  status           ActivityStatus @default(DIRENCANAKAN)
  notes            String?
  photoUrl         String?
  /// true untuk kegiatan rutin Selasa/Jumat yang dibuat otomatis oleh
  /// generator jadwal rutin (lihat src/lib/recurring-activity.ts) --
  /// supaya generator tahu tanggal mana yang sudah terisi dan tidak
  /// membuat duplikat, dan supaya jadwal rutin tidak pernah "ketinggalan"
  /// walau pengurus lupa membuatnya manual.
  isRoutine        Boolean        @default(false)
  createdById      String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  createdBy      User         @relation("ActivityCreator", fields: [createdById], references: [id])
  personInCharge User?        @relation("ActivityPIC", fields: [personInChargeId], references: [id])
  attendances    Attendance[]

  @@index([date])
  @@index([isRoutine, date])
}

model Attendance {
  id           String           @id @default(cuid())
  activityId   String
  userId       String
  status       AttendanceStatus
  recordedById String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User     @relation("AttendanceMember", fields: [userId], references: [id], onDelete: Cascade)
  recordedBy User     @relation("AttendanceRecorder", fields: [recordedById], references: [id])

  @@unique([activityId, userId])
}

// ============ Kas ============

/// Iuran bulanan terstruktur per anggota. HANYA bisa dicatat/diubah oleh
/// user dengan permission MANAGE_CASH_PAYMENT (diverifikasi di server).
model CashPayment {
  id            String            @id @default(cuid())
  userId        String
  month         Int
  year          Int
  amount        Int
  paymentDate   DateTime?
  status        CashPaymentStatus @default(BELUM_BAYAR)
  method        PaymentMethod?
  notes         String?
  recordedById  String?
  /// true = dibuat otomatis oleh sinkronisasi tab "KAS <tahun>" spreadsheet
  /// (akan ditimpa ulang tiap sinkron). false = dicatat manual oleh
  /// Bendahara lewat form "Catat Pembayaran Kas" -- TIDAK PERNAH dihapus
  /// atau ditimpa oleh proses sinkronisasi.
  syncedFromSheet Boolean         @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user       User  @relation("CashPaymentMember", fields: [userId], references: [id], onDelete: Cascade)
  recordedBy User? @relation("CashPaymentRecorder", fields: [recordedById], references: [id])

  @@unique([userId, month, year])
  @@index([year, month])
  @@index([syncedFromSheet])
}

/// Ledger umum organisasi (donasi, pengeluaran non-iuran) — terpisah dari
/// CashPayment (iuran bulanan per anggota). Sama-sama di-gate permission
/// MANAGE_CASH_PAYMENT untuk tulis.
model Transaction {
  id          String          @id @default(cuid())
  type        TransactionType
  category    String
  amount      Int
  description String?
  date        DateTime
  userId      String?
  /// true = dibuat otomatis oleh sinkronisasi spreadsheet Bendahara (akan
  /// ditimpa ulang tiap sinkron). false = ditambahkan manual lewat web —
  /// TIDAK PERNAH dihapus/ditimpa oleh proses sinkronisasi.
  syncedFromSheet Boolean     @default(false)
  createdAt   DateTime        @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([syncedFromSheet])
}

/// Ringkasan saldo kas resmi versi Bendahara (tab "Total Keuangan" di
/// spreadsheet) — sengaja disimpan TERPISAH dari total hasil hitung ledger
/// rinci, karena catatan rinci bisa saja belum lengkap untuk bulan-bulan
/// terbaru. Hanya ada 1 baris (singleton, id tetap "main").
model TreasurySummary {
  id              String   @id @default("main")
  saldoResmi      Int
  asOfLabel       String
  cumAmount       Int
  bendaharaAmount Int
  syncedAt        DateTime @default(now())
}

/// Ringkasan iuran bulanan per tahun/bulan, disinkron dari tab "KAS <tahun>"
/// spreadsheet (bukan dari CashPayment -- sheet KAS mencatat per anggota
/// per bulan lewat nama, terpisah dari fitur "Catat Pembayaran Kas" di web).
model DuesMonthlySummary {
  id          String   @id @default(cuid())
  year        Int
  month       Int
  totalAmount Int
  paidCount   Int
  memberCount Int
  syncedAt    DateTime @default(now())

  @@unique([year, month])
  @@index([year])
}

// ============ Partitur Koor ============

/// Satu judul lagu koor. Halaman-halaman partiturnya (hasil scan) disimpan
/// di ChoirSongPage, ditampilkan sebagai galeri gambar berurutan.
model ChoirSong {
  id        String   @id @default(cuid())
  title     String
  order     Int      @default(0)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User?           @relation(fields: [createdById], references: [id])
  pages     ChoirSongPage[]

  @@index([order])
}

model ChoirSongPage {
  id         String   @id @default(cuid())
  songId     String
  pageNumber Int
  imageUrl   String
  createdAt  DateTime @default(now())

  song ChoirSong @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([songId, pageNumber])
  @@index([songId])
}

// ============ Pengumuman & Forum (tidak berubah) ============

model Post {
  id        String   @id @default(cuid())
  type      PostType @default(FORUM)
  title     String
  content   String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User      @relation(fields: [authorId], references: [id])
  comments Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])
}

// ============ Lupa Password ============

/// Permintaan reset password dari halaman publik /lupa-password. TIDAK ada
/// pengiriman email otomatis — Admin melihat daftar permintaan di
/// /admin/password-reset lalu set password baru secara manual untuk user
/// yang emailnya cocok, atau menandai permintaan selesai tanpa reset.
model PasswordResetRequest {
  id           String               @id @default(cuid())
  email        String
  message      String?
  status       PasswordResetStatus  @default(PENDING)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime             @default(now())

  resolvedBy User? @relation(fields: [resolvedById], references: [id])

  @@index([status])
}

/// Permintaan anggota untuk mengubah biodatanya sendiri. Anggota TIDAK bisa
/// mengedit biodata langsung (nama, telepon, alamat, tempat/tanggal lahir,
/// marga ibu, dll) -- hanya Admin/Pengurus yang bisa, lewat /anggota/[id]/edit.
/// Anggota cuma bisa mengajukan permintaan (isi keterangan mau diubah apa)
/// lewat halaman Profil Saya; Admin/Pengurus melihat & memprosesnya di
/// /admin/profile-edit-requests.
model ProfileEditRequest {
  id           String              @id @default(cuid())
  userId       String
  message      String
  status       PasswordResetStatus @default(PENDING)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime            @default(now())

  user       User  @relation("ProfileEditRequester", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ProfileEditResolver", fields: [resolvedById], references: [id])

  @@index([status])
}

// ============ Audit Log ============

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  module      String
  recordId    String?
  description String
  ipAddress   String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([module])
  @@index([createdAt])
}
